{
  "name": "crisismesh",
  "version": "1.0.0",
  "description": "Resilient peer-to-peer store-and-forward mesh communication protocol & delay-tolerant engine for blackouts, emergency response and network outages with Ed25519 signed envelopes.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Manoj Rollo <fbxmano@gmail.com> (https://github.com/MRJonam91)",
  "homepage": "https://github.com/MRJonam91/CrisisMesh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRJonam91/CrisisMesh.git"
  },
  "bugs": {
    "url": "https://github.com/MRJonam91/CrisisMesh/issues"
  },
  "keywords": [
    "crisismesh",
    "mesh-network",
    "delay-tolerant-networking",
    "dtn",
    "store-and-forward",
    "emergency-communication",
    "blackout-resilience",
    "peer-to-peer",
    "cryptography",
    "ed25519",
    "disaster-response",
    "offline-first",
    "typescript",
    "anti-fragile"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "crisismesh": "dist/cli/index.js",
    "cmesh": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.it.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "trial": "node src/cli/index.ts trial",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/MRJonam91"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/mrjonam"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/mrjonam"
    },
    {
      "type": "paypal",
      "url": "https://paypal.me/manorollo"
    }
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.7.3"
  }
}
